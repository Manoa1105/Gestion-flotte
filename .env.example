# =============================================================================
# .env.example - Modèle de fichier de variables d'environnement
# =============================================================================
# IMPORTANT :
# Ce fichier (.env.example) est versionné dans Git pour servir de modèle.
# Tu dois le copier en ".env" (sans le .example) et y mettre TES vraies valeurs.
# Le vrai fichier .env n'est JAMAIS versionné (voir .gitignore).
#
# Pourquoi cette séparation ?
# Pour ne pas committer accidentellement des mots de passe sur GitHub.
# Le .env.example montre QUELLES variables existent, sans révéler leur contenu.
#
# Commande pour créer ton .env :
#   Sous Windows (PowerShell) : Copy-Item .env.example .env
#   Sous Windows (CMD)        : copy .env.example .env
# =============================================================================


# -----------------------------------------------------------------------------
# DJANGO - Paramètres principaux
# -----------------------------------------------------------------------------

# Clé secrète : utilisée par Django pour signer les cookies, sessions, tokens.
# DOIT être longue et aléatoire. À régénérer pour la production.
# Pour générer une nouvelle clé : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-changez-cette-cle-pour-une-vraie-cle-aleatoire

# Mode debug : True en développement (affiche les erreurs détaillées),
# False OBLIGATOIRE en production (sinon faille de sécurité grave).
DJANGO_DEBUG=True

# Hôtes autorisés à servir l'application.
# En dev : localhost suffit. En prod : ton vrai nom de domaine.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1


# -----------------------------------------------------------------------------
# BASE DE DONNÉES
# -----------------------------------------------------------------------------
# Par défaut, on utilise SQLite (un simple fichier db.sqlite3).
# C'est parfait pour démarrer : aucun serveur à installer.
#
# Quand tu seras prêt à passer à PostgreSQL :
#   1. Installe PostgreSQL sur ta machine
#   2. Crée une base et un utilisateur
#   3. Décommente les variables ci-dessous et remplis-les
#   4. Change DATABASE_ENGINE à "postgresql"
# -----------------------------------------------------------------------------

# Choix du moteur : "sqlite" (défaut, fichier local) ou "postgresql"
DATABASE_ENGINE=sqlite

# Variables PostgreSQL (utilisées seulement si DATABASE_ENGINE=postgresql)
DATABASE_NAME=gestion_flotte
DATABASE_USER=postgres
DATABASE_PASSWORD=changez_ce_mot_de_passe
DATABASE_HOST=localhost
DATABASE_PORT=5432


# -----------------------------------------------------------------------------
# LOCALISATION - Spécifique à Madagascar
# -----------------------------------------------------------------------------

# Fuseau horaire : Madagascar est en EAT (UTC+3), nom officiel "Indian/Antananarivo"
TIME_ZONE=Indian/Antananarivo

# Code de langue : français de France
LANGUAGE_CODE=fr-fr


# -----------------------------------------------------------------------------
# OSRM - Serveur de calcul d'itinéraires
# -----------------------------------------------------------------------------
# Par défaut on utilise le serveur public OSRM (gratuit mais rate-limité).
# Pour des performances optimales, héberge ton propre OSRM avec Docker
# (voir docker/osrm/README.md) et change l'URL ci-dessous.
#
# Public (défaut)  : https://router.project-osrm.org
# Local (Docker)   : http://localhost:5000
# -----------------------------------------------------------------------------
OSRM_URL=http://localhost:5000