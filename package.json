{
  "name": "gestion-flotte",
  "version": "0.1.0",
  "description": "Gestion de flotte de camions semi-remorques (Madagascar) - assets frontend",
  "private": true,
  "scripts": {
    "build-css": "tailwindcss -i ./static/css/input.css -o ./static/css/dist/output.css",
    "watch-css": "tailwindcss -i ./static/css/input.css -o ./static/css/dist/output.css --watch",
    "build-css-prod": "tailwindcss -i ./static/css/input.css -o ./static/css/dist/output.css --minify"
  },
  "devDependencies": {
    "tailwindcss": "^4.3.3",
    "@tailwindcss/forms": "^0.5.7"
  }
}
